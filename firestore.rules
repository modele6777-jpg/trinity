rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Specific Patterns
    match /users/{userId} {
      // Allow user access to their own document and subcollections
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /history/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /lucky/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /sharedState/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == docId;
    }
    
    // 2. Admin Escape Hatch (using email from current session)
    // This allows the developer to bypass all rules for debugging
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "modele2732@gmail.com";
    }

    // 3. Fallback Deny
    match /{document=**} {
       allow read, write: if false;
    }
  }
}
